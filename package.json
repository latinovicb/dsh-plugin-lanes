{
  "name": "dsh-plugin-lanes",
  "version": "0.1.0",
  "type": "module",
  "description": "Configures Subagent Director roles and installs the self-contained lanes agent preset for role-only delegation.",
  "author": "Borivoje Latinovic",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "subagent",
    "lanes",
    "agent-preset"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/latinovicb/dsh-plugin-lanes.git"
  },
  "homepage": "https://github.com/latinovicb/dsh-plugin-lanes#readme",
  "bugs": {
    "url": "https://github.com/latinovicb/dsh-plugin-lanes/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dependencies": {
    "dsh-plugin-subagent-director": "^0.6.0"
  },
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "files": [
    "README.md",
    "LICENSE",
    "index.js",
    "policy.md",
    "cordis.patch.yml",
    "gen-lanes-preset.py",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
